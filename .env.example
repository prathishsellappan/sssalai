# Frontend Environment Variables (Cloudflare Pages)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_STUDENT_LOGIN_EMAIL=students@school.example

# Supabase Edge Functions Secrets (Supabase Project Dashboard -> Settings -> Edge Functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-service-role-key-here
STUDENT_AUTH_USER_ID=your-shared-student-user-uuid